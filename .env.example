# Use 1 for the deterministic offline generator (the default and test setting).
# Set to 0 only when OPENAI_API_KEY is configured for the live provider.
FAKE_GENERATOR=1
RUN_INLINE=0

# OpenAI Image API (backend only; never expose this key to the frontend)
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint. Leave empty to use the official endpoint.
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-2-2026-04-21
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=auto
OPENAI_CRITIC_MODEL=gpt-5.6-terra
OPENAI_PLANNER_MODEL=gpt-5.6-luna
OPENAI_CRITIC_ESCALATION_MODEL=gpt-5.6-sol

# Local paths (resolved while backend commands run from backend/)
PET_FUSION_DATA_DIR=../data
PET_FUSION_APP_DB_PATH=../data/pet_fusion.sqlite3
PET_FUSION_CHECKPOINT_DB_PATH=../data/langgraph_checkpoints.sqlite3

# Development
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=26214400
MAX_TOTAL_UPLOAD_BYTES=78643200
MAX_IMAGE_PIXELS=40000000
MAX_TOTAL_IMAGE_PIXELS=80000000
WORKER_POLL_SECONDS=0.5
WORKER_LEASE_SECONDS=60
