# Use 1 for the deterministic offline generator (the default and test setting).
# Set to 0 only when OPENAI_API_KEY is configured for the live provider.
FAKE_GENERATOR=1
# Keep the multimodal Critic offline unless live Responses calls are explicitly enabled.
FAKE_CRITIC=1
# The default test suite always resets this to 0. It is reserved for a future
# opt-in automated live test; application provider selection is controlled only by
# the two FAKE_* switches above, so this variable is not an application safety gate.
RUN_OPENAI_LIVE_TESTS=0
RUN_INLINE=0

# OpenAI API (backend only; never expose this key to the frontend)
OPENAI_API_KEY=
# Optional backend-only SDK base URL. Leave empty for the official OpenAI endpoint.
# A controlled OpenAI-compatible relay must support both Images edits and Responses
# Structured Outputs before enabling the corresponding live switch.
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=auto
OPENAI_CRITIC_MODEL=gpt-5.6-terra
# Reserved model identifiers from the implementation guide. The current Planner is
# deterministic and no escalation transport is invoked yet.
OPENAI_PLANNER_MODEL=gpt-5.6-luna
OPENAI_CRITIC_ESCALATION_MODEL=gpt-5.6-sol

# Local paths (resolved while backend commands run from backend/)
PET_FUSION_DATA_DIR=../data
PET_FUSION_APP_DB_PATH=../data/pet_fusion.sqlite3
PET_FUSION_CHECKPOINT_DB_PATH=../data/langgraph_checkpoints.sqlite3

# Development
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=26214400
MAX_TOTAL_UPLOAD_BYTES=78643200
MAX_IMAGE_PIXELS=40000000
MAX_TOTAL_IMAGE_PIXELS=80000000
WORKER_POLL_SECONDS=0.5
WORKER_LEASE_SECONDS=60
